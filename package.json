{
  "name": "dsh-gh-pages-artifacts",
  "version": "0.1.1",
  "description": "DeepSeek Harness plugin that lets agents publish HTML pages and Markdown documents as shareable artifacts on GitHub Pages.",
  "license": "MIT",
  "author": "VibOtaku <vibotaku@vbytes.mozmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opdsh/dsh-gh-pages-artifacts.git"
  },
  "homepage": "https://github.com/opdsh/dsh-gh-pages-artifacts#readme",
  "bugs": {
    "url": "https://github.com/opdsh/dsh-gh-pages-artifacts/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "github-pages",
    "artifacts",
    "cordis",
    "publishing"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./client": "./client/client.js"
  },
  "bin": {
    "dsh-gh-pages-artifacts": "bin/setup.mjs"
  },
  "icon": "./icon.svg",
  "files": [
    "lib",
    "client",
    "assets",
    "bin",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json --noCheck",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4 || ^3.18.5-alpha.1",
    "micromark": "^4.0.3",
    "micromark-extension-gfm": "^3.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4 || ^4.0.5-alpha.1",
    "@deepseek-ai/dsh-credentials": "^0.2.0-rc.2 || ^0.2.1-alpha.1",
    "@deepseek-ai/dsh-launch-environment": "^0.2.0-rc.2 || ^0.2.1-alpha.1",
    "@deepseek-ai/dsh-skill": "^0.2.0-rc.2 || ^0.2.1-alpha.1",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.2 || ^0.2.1-alpha.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-credentials": {
      "optional": true
    },
    "@deepseek-ai/dsh-launch-environment": {
      "optional": true
    },
    "@deepseek-ai/dsh-skill": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-agent-loop": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-attachment": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-credentials": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-fs": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-fs-local": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-launch-environment": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-session-projection": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-skill": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-user-approval": "0.2.1-alpha.1",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "6.0.3",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@12.6.0"
}
